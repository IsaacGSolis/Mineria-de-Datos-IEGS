import numpy as np
from scipy import stats
#Ejercicio 1
#Tabla de frecuencias observadas
tabla=np.array([[85,65],[50,100]])
#Realiza la prueba de chi-cuadrado de independencia stats.chi2_contingency devuelve el estadistico chi-cuadrado, el p-value, los grados de libertad y las frecuencias esperadas
chi2,p_value,gl,esperados=stats.chi2_contingency(tabla,correction=False)
#Imprime resultados
print("Ejercicio 1")
print(f"Chi-cuadrado={chi2:.4f}")
print(f"p-value={p_value:.4f}")
print(f"Grados de libertad={gl}")
print("Frecuencias esperadas:")
print(esperados)
alpha=0.05
if p_value < alpha:
    print("Hay evidencia suficiente para determinar que la preferencia de transporte depende de la ciudad.")
else:
    print("No hay evidencia suficiente para determinar que la preferencia de transporte depende de la ciudad.")
